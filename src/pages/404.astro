---
// GitHub Pages serves this for any URL that does not exist.
import Base from "../layouts/Base.astro";
import { profile } from "../data.js";

const home = import.meta.env.BASE_URL;
---

<Base title={`Not found — ${profile.nameEn}`} path="/404" noindex>
  <header class="site-header">
    <h1>{profile.nameEn}</h1>
  </header>
  <div class="page page-narrow">
    <main>
      <section>
        <h2>Page not found</h2>
        <hr />
        <div class="prose">
          <p>
            That address does not exist here. <a href={home}>Back to the
            homepage</a>.
          </p>
        </div>
      </section>
    </main>
  </div>
</Base>

<style>
  /* One column: the 404 has no sidebar to sit beside. */
  .page-narrow {
    grid-template-columns: 1fr;
  }
</style>
